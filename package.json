{
  "name": "vantage-ess",
  "version": "4.4.0",
  "description": "Vantage ESS - Employee Self-Service Platform",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "check": "node --check main.js && node --check preload.js"
  },
  "dependencies": {
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.vantage.ess",
    "productName": "Vantage ESS",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "login.html",
      "app.html",
      "auth.js",
      "build/icon.png"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "YOUR_GITHUB_USERNAME",
        "repo": "vantage-ess"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    },
    "directories": {
      "buildResources": "build"
    }
  },
  "author": "Vantage ESS",
  "license": "UNLICENSED",
  "private": true
}